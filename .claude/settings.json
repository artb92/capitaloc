{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm dev)",
      "Bash(pnpm check)",
      "Bash(pnpm fix)",
      "Bash(pnpm lint)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm test:*)",
      "Bash(pnpm build)",
      "Bash(pnpm install)"
    ],
    "deny": [
      "Read(./pnpm-lock.yaml)",
      "Read(./node_modules/**)",
      "Read(./dist/**)",
      "Read(./coverage/**)",
      "Read(./src/data/**/*.json)",
      "Read(./public/data/**)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-start.sh" }
        ]
      }
    ]
  }
}
